# Copy to a secret-managed runtime environment. Never commit real values.
SPECENGINE_ENV=production
SPECENGINE_DATA_ROOT=/app/data
SPECENGINE_DATA_DIR=/app/data
SPECENGINE_CORS_ORIGINS=https://specengine.example
SPECENGINE_MAX_REQUEST_BYTES=16384
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

BIS_LLM_PROVIDER=gemini
BIS_LLM_MODEL=gemini-3.6-flash
BIS_LLM_API_KEY=
BIS_LLM_API_URL=https://generativelanguage.googleapis.com/v1beta
BIS_LLM_TIMEOUT_SECONDS=20
