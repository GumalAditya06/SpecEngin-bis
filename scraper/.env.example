# Environment: development, demo, production, or test.
SPECENGINE_ENV=development

# Stage 4.2 grounded-answer provider. Credentials are never committed.
BIS_LLM_PROVIDER=gemini
BIS_LLM_MODEL=gemini-3.6-flash
BIS_LLM_API_KEY=
BIS_LLM_API_URL=https://generativelanguage.googleapis.com/v1beta
BIS_LLM_TIMEOUT_SECONDS=20

# Retrieval/API boundary settings. DATA_DIR must resolve within DATA_ROOT.
SPECENGINE_DATA_ROOT=data
SPECENGINE_DATA_DIR=data
SPECENGINE_CORS_ORIGINS=http://localhost:3000
SPECENGINE_MAX_REQUEST_BYTES=16384
