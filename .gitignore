# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Python service state. Source code and the curated corpus data are tracked.
/backend/.venv/
/backend/.pytest_cache/
/backend/.env
/backend/local.db
/backend/local.db.bak
/backend/**/__pycache__/
/scraper/.git/
/scraper/.venv/
/scraper/.pytest_cache/
/scraper/.env
/scraper/**/__pycache__/
/scraper/data/raw/
/scraper/data/metadata/crawl_log.jsonl
*.py[cod]
