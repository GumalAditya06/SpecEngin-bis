# Template for backend environment variables (copy to .env and fill in).
# All vars use the BIS_ prefix via pydantic-settings.

# Required for LLM generation; without it the API runs in extractive mode.
BIS_LLM_API_KEY=

# Optional — defaults shown
# BIS_LLM_MODEL=gemini-3.6-flash
# BIS_LLM_API_URL=https://generativelanguage.googleapis.com/v1beta
# BIS_LLM_TIMEOUT_SECONDS=20
# BIS_DATABASE_URL=postgresql+asyncpg://bis:standards@localhost/bis_standards
# BIS_SECRET_KEY=dev-secret
